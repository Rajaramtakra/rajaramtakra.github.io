# --- Database ---
DATABASE_URL="postgresql://erp_user:erp_password@localhost:5432/school_erp?schema=public"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# --- File storage ---
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# --- Seed ---
SEED_SCHOOL_NAME="Khwopring International School"
SEED_SCHOOL_CODE="KIS"
SEED_ADMIN_EMAIL="admin@khwopring.edu"
SEED_ADMIN_PASSWORD="Admin@12345"
